// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  SUPER_ADMIN
  UNIVERSITY
  COUNSELOR
}

enum CounselorStatus {
  INVITED
  PROFILE_PENDING
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SessionStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED_BY_STUDENT
  CANCELLED_BY_COUNSELOR
  EXPIRED
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String?
  firstName         String
  lastName          String
  role              Role     @default(STUDENT)
  timezone          String   @default("UTC")
  deletedAt         DateTime?
  googleId          String?  @unique
  universityId      String?
  university        University? @relation(fields: [universityId], references: [id])
  quizResults       QuizResult[]
  chatMessages      ChatMessage[]
  dailyCheckins     DailyCheckin[]
  talkNotes         TalkNote[]
  talkReplies       TalkReply[]
  talkReactions     TalkReaction[]
  talkReports       TalkReport[]
  talkNickname      String?   @unique
  talkAvatar        String?
  talkBio           String?   @db.Text
  talkTermsAccepted Boolean   @default(false)
  counselorProfile  CounselorProfile?
  studentSessions   CounselorSession[] @relation("StudentSessions")
  auditLogs         AuditLog[] @relation("ActorAuditLogs")
  notifications     Notification[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model University {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String   @unique
  verified  Boolean  @default(false)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quiz {
  id             String   @id @default(uuid())
  title          String
  description    String?  @db.Text
  category       String
  totalQuestions Int
  maxScore       Int
  quizResults    QuizResult[]
  questions      Question[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Question {
  id        String   @id @default(uuid())
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  index     Int
  text      String   @db.Text
  type      String   @default("MULTIPLE_CHOICE")
  options   QuestionOption[]
  createdAt DateTime @default(now())
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  points     Int
}

model QuizResult {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId         String
  quiz           Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  overallScore   Int
  classification String
  completedAt    DateTime      @default(now())
  feedback       QuizFeedback?

  @@index([userId, completedAt])
}

model QuizFeedback {
  id        String     @id @default(uuid())
  resultId  String     @unique
  result    QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  rating    Int
  comments  String?    @db.Text
  createdAt DateTime   @default(now())
}

enum Sender {
  USER
  AI
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender    Sender
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Waitlist {
  id        String   @id @default(uuid())
  email     String
  feature   String
  createdAt DateTime @default(now())

  @@unique([email, feature])
}

model DailyCheckin {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model CrisisHotline {
  id          String   @id @default(uuid())
  name        String
  description String   @db.Text
  phone       String
  website     String
  category    String
  country     String
  createdAt   DateTime @default(now())

  @@index([category])
}

model ContactRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model UniversityOnboarding {
  id             String   @id @default(uuid())
  name           String
  email          String
  universityName String
  role           String
  phone          String?
  message        String   @db.Text
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model CounselorOnboarding {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  credentials String
  experience  String   @db.Text
  message     String   @db.Text
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

enum TalkStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum ReactionType {
  SUPPORT
  HUG
  METOO
}

model TalkRoom {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?    @db.Text
  isActive    Boolean    @default(true)
  notes       TalkNote[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TalkNote {
  id           String         @id @default(uuid())
  roomId       String
  room         TalkRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname     String
  avatar       String
  content      String         @db.Text
  status       TalkStatus     @default(APPROVED)
  meTooCount   Int            @default(0)
  isReported   Boolean        @default(false)
  aiScore      Float?
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  moderationReason String?        @db.Text
  replies          TalkReply[]
  reactions        TalkReaction[]
  reports          TalkReport[]
  createdAt        DateTime       @default(now())

  @@index([roomId, status, createdAt])
  @@index([userId, createdAt])
}

model TalkReply {
  id           String       @id @default(uuid())
  noteId       String
  note         TalkNote     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nickname     String
  avatar       String
  content      String       @db.Text
  status       TalkStatus   @default(APPROVED)
  inputTokens      Int          @default(0)
  outputTokens     Int          @default(0)
  moderationReason String?      @db.Text
  reports          TalkReport[]
  createdAt        DateTime     @default(now())

  @@index([noteId, status, createdAt])
  @@index([userId, createdAt])
}

model TalkReaction {
  id        String       @id @default(uuid())
  noteId    String
  note      TalkNote     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([noteId, userId, type])
}

model TalkReport {
  id        String     @id @default(uuid())
  noteId    String?
  note      TalkNote?  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     TalkReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?    @db.Text
  createdAt DateTime   @default(now())

  @@index([createdAt])
}

model CounselorProfile {
  id                    String            @id @default(uuid())
  userId                String            @unique
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations       String[]
  credentials           String
  bio                   String?           @db.Text
  avatarUrl             String?
  phone                 String?
  status                CounselorStatus   @default(INVITED)
  version               Int               @default(1)
  deletedAt             DateTime?
  availabilities        CounselorAvailability[]
  exceptions            CounselorAvailabilityException[]
  sessions              CounselorSession[] @relation("CounselorSessions")
  notes                 SessionNote[]
  receivedFeedback      StudentFeedback[]
  givenFeedback         CounselorFeedback[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status])
}

model CounselorAvailability {
  id                 String           @id @default(uuid())
  counselorId        String
  counselor          CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  dayOfWeek          Int              // 0 = Sunday, 6 = Saturday
  startTime          String           // "09:00"
  endTime            String           // "17:00"
  slotDurationMins   Int              @default(45)
  isAvailable        Boolean          @default(true)
  createdAt          DateTime         @default(now())

  @@index([counselorId, dayOfWeek])
}

model CounselorAvailabilityException {
  id                 String           @id @default(uuid())
  counselorId        String
  counselor          CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)
  startDate          DateTime
  endDate            DateTime
  isFullDay          Boolean          @default(true)
  reason             String?
  createdAt          DateTime         @default(now())

  @@index([counselorId, startDate, endDate])
}

model CounselorSession {
  id                 String           @id @default(uuid())
  counselorId        String
  counselor          CounselorProfile @relation("CounselorSessions", fields: [counselorId], references: [id])
  studentId          String
  student            User             @relation("StudentSessions", fields: [studentId], references: [id])
  startTime          DateTime
  endTime            DateTime
  status             SessionStatus    @default(CONFIRMED)
  meetingLink        String
  cancellationReason String?
  version            Int              @default(1)
  deletedAt          DateTime?
  notes              SessionNote[]
  studentFeedback    StudentFeedback?
  counselorFeedback  CounselorFeedback?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([counselorId, startTime])
  @@index([studentId, startTime])
  @@index([status])
}

model SessionNote {
  id                 String           @id @default(uuid())
  sessionId          String
  session            CounselorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  counselorId        String
  counselor          CounselorProfile @relation(fields: [counselorId], references: [id])
  studentId          String
  title              String
  content            String           @db.Text
  isPrivate          Boolean          @default(true)
  isDraft            Boolean          @default(false)
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([sessionId])
  @@index([counselorId, studentId])
}

model StudentFeedback {
  id                 String           @id @default(uuid())
  sessionId          String           @unique
  session            CounselorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  counselorId        String
  counselor          CounselorProfile @relation(fields: [counselorId], references: [id])
  studentId          String
  rating             Int
  comments           String?          @db.Text
  answers            Json?
  deletedAt          DateTime?
  createdAt          DateTime         @default(now())

  @@index([counselorId, rating])
}

model CounselorFeedback {
  id                 String           @id @default(uuid())
  sessionId          String           @unique
  session            CounselorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  counselorId        String
  counselor          CounselorProfile @relation(fields: [counselorId], references: [id])
  studentId          String
  rating             Int
  summaryNote        String           @db.Text
  answers            Json?
  createdAt          DateTime         @default(now())

  @@index([counselorId])
}

model CounselorInvitation {
  id                 String           @id @default(uuid())
  email              String           @unique
  firstName          String
  lastName           String
  token              String           @unique
  expiresAt          DateTime
  used               Boolean          @default(false)
  createdAt          DateTime         @default(now())
}

model AuditLog {
  id                 String           @id @default(uuid())
  actorId            String?
  actor              User?            @relation("ActorAuditLogs", fields: [actorId], references: [id])
  action             String
  targetEntity       String
  targetId           String?
  ipAddress          String?
  details            Json?
  createdAt          DateTime         @default(now())

  @@index([action, createdAt])
}

model Notification {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  message            String           @db.Text
  type               String
  read               Boolean          @default(false)
  createdAt          DateTime         @default(now())

  @@index([userId, read])
}

model AllowedUniversityDomain {
  id                 String           @id @default(uuid())
  domain             String           @unique
  name               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model BypassEmail {
  id                 String           @id @default(uuid())
  email              String           @unique
  note               String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}



