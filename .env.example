PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wellmindly
JWT_SECRET=your_jwt_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Gemini API & Chat configurations
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it
CHAT_SESSION_MAX_REQUESTS=60
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://wellmindly.com

# Jitsi Telehealth Video Configuration
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=wellmindly
# Set JITSI_APP_SECRET to enable cryptographic JWT tokens for moderator (counselor) vs guest (student)
# JITSI_APP_SECRET=your_jitsi_jwt_secret_here

